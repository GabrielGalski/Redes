# Parâmetros de referência do laboratório; nenhum serviço lê este arquivo ainda.
# Quando os scripts forem implementados, copiar para config/lab.env.
# Ajustar a sub-rede se houver sobreposição com a rede do hospedeiro/VPN.
LAB_DOMAIN=cardeal.local
LAB_LAN_NAME=cardeal-lan
LAB_SUBNET=192.168.50.0/24
LAB_NETMASK=255.255.255.0
LAB_GATEWAY_IP=192.168.50.1
LAB_SERVER_IP=192.168.50.10
LAB_DNS_IP=192.168.50.10
LAB_DHCP_START=192.168.50.100
LAB_DHCP_END=192.168.50.200
LAB_DHCP_LEASE_SECONDS=3600

LAB_GATEWAY_VM=cardeal-gw
LAB_SERVER_VM=cardeal-srv
LAB_CLIENT_VM=cardeal-cli
LAB_GATEWAY_RAM_MIB=512
LAB_SERVER_RAM_MIB=1024
LAB_CLIENT_RAM_MIB=512
LAB_GATEWAY_CPUS=1
LAB_SERVER_CPUS=2
LAB_CLIENT_CPUS=1
LAB_GATEWAY_DISK_GIB=8
LAB_SERVER_DISK_GIB=16
LAB_CLIENT_DISK_GIB=8

# Preencher após identificar interfaces e MACs reais em cada VM.
LAB_GATEWAY_WAN_IFACE=
LAB_GATEWAY_LAN_IFACE=
LAB_SERVER_LAN_IFACE=
LAB_CLIENT_LAN_IFACE=

# Portas no hospedeiro; servidor e cliente são temporários no bootstrap.
LAB_SSH_BIND_ADDRESS=127.0.0.1
LAB_GATEWAY_SSH_HOST_PORT=2222
LAB_SERVER_BOOTSTRAP_SSH_HOST_PORT=2223
LAB_CLIENT_BOOTSTRAP_SSH_HOST_PORT=2224
# Conta de administração a definir na instalação. Não colocar senha aqui.
LAB_SSH_ADMIN_USER=
