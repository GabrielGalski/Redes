# Planejamento local.
/docs/
/sprints.md

# Material pessoal de estudo, incluindo o PDF e seus arquivos de geração.
/estudo/

# Documentos PDF e exportações reproduzíveis, mantidos apenas localmente.
*.[pP][dD][fF]
/entrega/
/logs/relatorio/relatorio.html
/logs/relatorio/exportacao-firefox.log
/evidencias/*/manifesto-entrega.json

# Metadados locais do ambiente de desenvolvimento.
/.agents/
/.codex/
/.aws/

# Configuração local e credenciais.
/config/lab.env
/config/*.local.env
/secrets/
.env
.env.*
!.env.example

# Imagens e arquivos locais pesados do laboratório.
/vms/
/isos/
*.vdi
*.vmdk
*.qcow2
*.iso

# Dependências instaladas e pacotes baixados; versionar apenas os manifestos.
.venv/
venv/
node_modules/
*.deb
*.rpm
*.AppImage

# Arquivos temporários e backups locais.
/tmp/
/backups/
*.swp
*.swo
*~
__pycache__/
*.py[cod]

# Capturas, evidências e fonte Markdown do relatório permanecem versionáveis.
