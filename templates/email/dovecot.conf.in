dovecot_config_version = 2.4.0
dovecot_storage_version = 2.4.0
protocols = imap
listen = 127.0.0.1, @LAB_SERVER_IP@
ssl = no
auth_allow_cleartext = yes
auth_mechanisms = plain login
auth_username_format = %{user | lower}
mail_driver = maildir
mail_path = %{home}/Maildir
first_valid_uid = 1000
log_path = /var/log/dovecot.log
info_log_path = /var/log/dovecot.log
namespace inbox {
    inbox = yes
    separator = /
}
passdb passwd-file {
    passwd_file_path = /etc/dovecot/cardeal-users
}
userdb passwd-file {
    passwd_file_path = /etc/dovecot/cardeal-users
}
service imap-login {
    inet_listener imap {
        port = 143
    }
    inet_listener imaps {
        port = 0
    }
}
