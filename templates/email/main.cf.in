compatibility_level = 3.6
myhostname = mail.@LAB_DOMAIN@
mydomain = @LAB_DOMAIN@
myorigin = $mydomain
mydestination = $myhostname, $mydomain, localhost.$mydomain, localhost
inet_interfaces = 127.0.0.1, @LAB_SERVER_IP@
inet_protocols = ipv4
mynetworks = 127.0.0.0/8, @LAB_SUBNET@
home_mailbox = Maildir/
mailbox_command =
alias_maps = hash:/etc/aliases
alias_database = hash:/etc/aliases
local_recipient_maps = hash:/etc/postfix/cardeal-recipients
smtpd_client_restrictions = permit_mynetworks, reject
smtpd_relay_restrictions = reject_unauth_destination
smtpd_recipient_restrictions = reject_unlisted_recipient, check_recipient_access hash:/etc/postfix/cardeal-recipients, reject
smtpd_reject_unlisted_recipient = yes
relay_domains =
relayhost =
default_transport = error:5.7.1 Somente correio interno Cardeal
relay_transport = error:5.7.1 Relay externo desabilitado
smtpd_sasl_auth_enable = no
smtpd_tls_security_level = none
smtp_tls_security_level = none
disable_vrfy_command = yes
message_size_limit = 2097152
mailbox_size_limit = 0
recipient_delimiter =
smtpd_banner = $myhostname ESMTP Cardeal
maillog_file = /var/log/postfix.log
