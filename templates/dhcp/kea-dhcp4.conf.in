{
  "Dhcp4": {
    "interfaces-config": {"interfaces": ["@LAN_IF@"]},
    "authoritative": true,
    "lease-database": {"type": "memfile", "persist": true, "name": "/var/lib/kea/kea-leases4.csv"},
    "valid-lifetime": @LAB_DHCP_LEASE_SECONDS@,
    "renew-timer": 900,
    "rebind-timer": 1800,
    "subnet4": [{
      "id": 1,
      "subnet": "@LAB_SUBNET@",
      "pools": [{"pool": "@LAB_DHCP_START@ - @LAB_DHCP_END@"}],
      "option-data": [
        {"name": "subnet-mask", "data": "@LAB_NETMASK@"},
        {"name": "routers", "data": "@LAB_GATEWAY_IP@"},
        {"name": "domain-name-servers", "data": "@LAB_DNS_IP@"},
        {"name": "domain-name", "data": "@LAB_DOMAIN@"}
      ]
    }]
  }
}
