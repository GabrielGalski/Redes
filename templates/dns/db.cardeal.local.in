$TTL 300
@ IN SOA ns.@LAB_DOMAIN@. admin.@LAB_DOMAIN@. (
    2026110501 3600 900 604800 300 )
@ IN NS ns.@LAB_DOMAIN@.
@ IN MX 10 mail.@LAB_DOMAIN@.
ns    IN A @LAB_SERVER_IP@
srv   IN A @LAB_SERVER_IP@
www   IN A @LAB_SERVER_IP@
mail  IN A @LAB_SERVER_IP@
files IN A @LAB_SERVER_IP@
gw    IN A @LAB_GATEWAY_IP@
